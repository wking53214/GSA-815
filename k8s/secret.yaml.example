# Template only -- do not commit a filled-in version of this file.
# Create the real secret with actual values, e.g.:
#
#   kubectl create secret generic iceberg-secrets \
#     --namespace=iceberg \
#     --from-literal=postgres-host=<your-postgres-host> \
#     --from-literal=postgres-password=<real-password> \
#     --from-literal=claude-api-key=<real-key> \
#     --from-literal=ledger-attestation-key=$(openssl rand -hex 32)
#
# or fill in this file locally (never commit it) and apply with
# `kubectl apply -f secret.yaml.local`.
apiVersion: v1
kind: Secret
metadata:
  name: iceberg-secrets
  namespace: iceberg
type: Opaque
stringData:
  postgres-host: ""
  postgres-password: ""
  claude-api-key: ""
  # Required unless the key is supplied as a file (see deployment.yaml).
  # Consumed by ICEBERG_LEDGER_ATTESTATION_KEY in deployment.yaml. An empty
  # value counts as unset and the ledger will refuse to start. Use a distinct
  # value per environment and generate it with `openssl rand -hex 32`.
  ledger-attestation-key: ""
  # Optional. Keys retired from signing but still trusted for verification,
  # comma-separated. Where an old key goes after a rotation -- see
  # DEPLOYMENT.md "Key rotation".
  ledger-attestation-keys-previous: ""
